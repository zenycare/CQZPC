<%- include('../layouts/header') %>
<div class="row justify-content-center">
  <div class="col-lg-8">
    <div class="card rounded-4 shadow-sm border-0"><div class="card-body p-4">
      <h3 class="mb-3">Hồ sơ ứng viên</h3>
      <% if (success) { %><div class="alert alert-success"><%= success %></div><% } %>
      <% if (error) { %><div class="alert alert-danger"><%= error %></div><% } %>
      <form method="post" action="/candidate/profile" enctype="multipart/form-data" class="row g-3">
        <div class="col-md-6"><label class="form-label">Họ tên</label><input class="form-control" name="name" value="<%= profile.name || '' %>" required></div>
        <div class="col-md-6"><label class="form-label">Email</label><input class="form-control" value="<%= profile.email || '' %>" disabled></div>
        <div class="col-md-6"><label class="form-label">Điện thoại</label><input class="form-control" name="phone" value="<%= profile.phone || '' %>"></div>
        <div class="col-md-6"><label class="form-label">Headline</label><input class="form-control" name="headline" value="<%= profile.headline || '' %>"></div>
        <div class="col-12"><label class="form-label">Địa chỉ</label><input class="form-control" name="address" value="<%= profile.address || '' %>"></div>
        <div class="col-12"><label class="form-label">Tải CV</label><input class="form-control" type="file" name="cv_file" accept=".pdf,.doc,.docx"></div>
        <% if (profile.cv_file) { %><div class="col-12"><a href="<%= profile.cv_file %>" target="_blank">Xem CV hiện tại</a></div><% } %>
        <div class="col-12"><button class="btn btn-primary">Lưu hồ sơ</button></div>
      </form>
    </div></div>
  </div>
</div>
<%- include('../layouts/footer') %>
