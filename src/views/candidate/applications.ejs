<%- include('../layouts/header') %>
<h3 class="mb-3">Danh sách công việc đã ứng tuyển</h3>
<div class="card rounded-4 shadow-sm border-0"><div class="card-body p-0">
  <div class="table-responsive">
    <table class="table table-hover mb-0">
      <thead><tr><th>Công việc</th><th>Công ty</th><th>Ngành nghề</th><th>Địa điểm</th><th>Trạng thái</th><th>Ngày apply</th></tr></thead>
      <tbody>
        <% applications.forEach(item => { %>
          <tr>
            <td><a href="/jobs/<%= item.job_id %>"><%= item.title %></a></td>
            <td><%= item.company_name %></td>
            <td><%= item.career_name %></td>
            <td><%= item.province %></td>
            <td><span class="badge text-bg-secondary"><%= item.status %></span></td>
            <td><%= new Date(item.created_at).toLocaleDateString('vi-VN') %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div></div>
<%- include('../layouts/footer') %>
