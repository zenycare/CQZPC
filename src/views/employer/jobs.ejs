<%- include('../layouts/header') %>
<div class="d-flex justify-content-between align-items-center mb-3">
  <h3 class="mb-0">Tin tuyển dụng của tôi</h3>
  <a href="/employer/jobs/create" class="btn btn-primary">Đăng tin mới</a>
</div>
<div class="card rounded-4 shadow-sm border-0"><div class="card-body p-0">
  <div class="table-responsive">
    <table class="table table-hover mb-0">
      <thead><tr><th>Tiêu đề</th><th>Ngành nghề</th><th>Trạng thái</th><th>CV</th><th></th></tr></thead>
      <tbody>
        <% jobs.forEach(job => { %>
          <tr>
            <td><%= job.title %><div class="small text-muted"><%= job.company_name %></div></td>
            <td><%= job.career_name %></td>
            <td><span class="badge text-bg-secondary"><%= job.status %></span></td>
            <td><%= job.total_applications %></td>
            <td><a class="btn btn-sm btn-outline-primary" href="/employer/jobs/<%= job.id %>/edit">Sửa</a></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div></div>
<%- include('../layouts/footer') %>
